{
    "name": "aldogtz/amadeus-soap",
    "description": "Laravel wrapper for Amadeus Globalizer SOAP Web Services",
    "keywords": ["laravel", "amadeus", "soap", "gds", "hotel", "booking"],
    "license": "MIT",
    "authors": [
        {
            "name": "Aldo Gutierrez",
            "email": "aldogtz1998@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/array-to-xml": "^3.1",
        "ext-soap": "*",
        "ext-dom": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Aldogtz\\AmadeusSoap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aldogtz\\AmadeusSoap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aldogtz\\AmadeusSoap\\AmadeusSoapServiceProvider"
            ],
            "aliases": {
                "AmadeusSoap": "Aldogtz\\AmadeusSoap\\Facades\\Amadeus"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
