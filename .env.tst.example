# Credenciales de Amadeus TST para scripts/tst-chain.php
#
#   cp .env.tst.example .env.tst      # .env.tst está gitignored
#   # llena AMADEUS_PASSWORD
#   set -a; source .env.tst; set +a
#   php scripts/tst-chain.php --hotel=YZMTY045 --book
#
# Cárgalo en la shell con `set -a; source .env.tst; set +a` en lugar de
# poner los valores en la línea de comando: así no quedan en el historial
# ni visibles en `ps`.

AMADEUS_WSDL_PATH=/path/to/amadeus/tst/wsdl
AMADEUS_USERNAME=your_tst_username
AMADEUS_OFFICE_ID=your_tst_office_id
AMADEUS_PASSWORD=

# Solo para --book: garantía de la reserva. Usa una tarjeta de prueba que
# tu oficina de TST acepte; nunca una tarjeta real.
AMADEUS_TST_CARD_VENDOR=AX
AMADEUS_TST_CARD_NUMBER=
AMADEUS_TST_CARD_CVC=
AMADEUS_TST_CARD_EXPIRY=MMYY

# Opcionales
AMADEUS_TST_CARD_HOLDER=Enlaceforte
AMADEUS_TST_PAX_SURNAME=TEST
AMADEUS_TST_PAX_FIRSTNAME=TESTER
