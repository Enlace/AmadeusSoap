# Amadeus SOAP Configuration

# Credentials
AMADEUS_USERNAME=your_username
AMADEUS_PASSWORD=your_password
AMADEUS_OFFICE_ID=your_office_id

# WSDL Path
AMADEUS_WSDL_PATH=/path/to/amadeus/wsdl/files

# Endpoint Override (optional)
# AMADEUS_ENDPOINT=https://custom-endpoint.amadeus.com

# Session Configuration
AMADEUS_SESSION_DRIVER=redis
AMADEUS_SESSION_CONNECTION=default
AMADEUS_SESSION_PREFIX=amadeus_session_
AMADEUS_SESSION_TTL=900
AMADEUS_SESSION_SIGN_OUT_REPLACED=true

# SOAP Client Options
AMADEUS_SOAP_TRACE=true
AMADEUS_CONNECTION_TIMEOUT=30
AMADEUS_TIMEOUT=60

# Retry Configuration
AMADEUS_RETRY_ENABLED=true
AMADEUS_RETRY_MAX_ATTEMPTS=3
AMADEUS_RETRY_BASE_DELAY_MS=500
AMADEUS_RETRY_MULTIPLIER=2.0
AMADEUS_RETRY_MAX_DELAY_MS=5000

# Logging
AMADEUS_LOGGING=false
AMADEUS_LOG_CHANNEL=stack

# Debug Mode
AMADEUS_DEBUG=false

# Contact Email
AMADEUS_CONTACT_EMAIL=your-email@example.com

# Response Cache (stateless searches and descriptive info only)
AMADEUS_CACHE_ENABLED=false
# AMADEUS_CACHE_STORE=redis
AMADEUS_CACHE_PREFIX=amadeus_cache
AMADEUS_CACHE_SEARCH_TTL=300
AMADEUS_CACHE_INFO_TTL=3600

# Performance Monitoring
AMADEUS_MONITORING_ENABLED=false
# AMADEUS_MONITORING_STORE=redis
AMADEUS_MONITORING_STORE_HOURS=24

# Amadeus SearchCacheLevel: Live, VeryRecent or LessRecent
AMADEUS_DEFAULT_SEARCH_CACHE_LEVEL=Live
AMADEUS_LISTING_CACHE_LEVEL=VeryRecent
AMADEUS_DETAILS_CACHE_LEVEL=VeryRecent

# Rate strategy for multi-hotel searches: best_only or all_rates
AMADEUS_DEFAULT_RATE_STRATEGY=best_only
